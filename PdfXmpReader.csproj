<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>PdfXmpReader</PackageId>
    <Version>1.0.0</Version>
    <Authors>Gerben de Vries</Authors>
    <Description>Reads XMP metadata from PDF files using qpdf.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/gerbendv/PdfXmpReader</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gerbendv/PdfXmpReader</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>pdf;xmp;metadata;qpdf</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PdfXmpReader.cs" />
    <Compile Include="QpdfNativeApi.cs" />
    <Compile Include="QpdfMetadataReader.cs" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <None Include="LICENSE.qpdf.txt" Pack="true" PackagePath="licenses/qpdf/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="NOTICE.qpdf.txt" Pack="true" PackagePath="licenses/qpdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtimes/linux-x64/native/*"
          Pack="true"
          PackagePath="runtimes/linux-x64/native/"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="runtimes/win-x64/native/*"
          Pack="true"
          PackagePath="runtimes/win-x64/native/"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
