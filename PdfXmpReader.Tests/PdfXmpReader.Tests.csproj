<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PdfXmpReader.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\runtimes\linux-x64\native\*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\runtimes\win-x64\native\*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)/nunit3testadapter/6.2.0/build/net8.0/nunit.engine.api.dll" Link="nunit.engine.api.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NuGetPackageRoot)/nunit3testadapter/6.2.0/build/net8.0/nunit.engine.api.dll')" />
    <None Include="$(NuGetPackageRoot)/testcentric.engine/2.0.0/lib/netstandard2.0/testcentric.engine.metadata.dll" Link="testcentric.engine.metadata.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NuGetPackageRoot)/testcentric.engine/2.0.0/lib/netstandard2.0/testcentric.engine.metadata.dll')" />
    <None Include="$(NuGetPackageRoot)/nunit3testadapter/6.2.0/build/net8.0/nunit.engine.dll" Link="nunit.engine.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NuGetPackageRoot)/nunit3testadapter/6.2.0/build/net8.0/nunit.engine.dll')" />
    <None Include="$(NuGetPackageRoot)/nunit3testadapter/6.2.0/build/net8.0/nunit.engine.core.dll" Link="nunit.engine.core.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NuGetPackageRoot)/nunit3testadapter/6.2.0/build/net8.0/nunit.engine.core.dll')" />
    <None Include="$(NuGetPackageRoot)/nunit3testadapter/6.2.0/build/net8.0/testcentric.engine.metadata.dll" Link="testcentric.engine.metadata.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NuGetPackageRoot)/nunit3testadapter/6.2.0/build/net8.0/testcentric.engine.metadata.dll')" />
  </ItemGroup>
</Project>
